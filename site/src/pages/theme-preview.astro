---
import antaStylesheet from '@antadesign/anta/bundle.css?url'
import ThemeScreens from '../components/theme-configurator/ThemeScreens'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Theme preview</title>
    <link rel="stylesheet" href={antaStylesheet} />
    <link id="preview-theme" rel="stylesheet" href="/themes/default.css" />
    <link id="preview-fonts" rel="stylesheet" href="/themes/default.css" />
    <script is:inline>
      if (window.parent !== window) {
        try { document.documentElement.classList.toggle('dark', parent.document.documentElement.classList.contains('dark')) } catch {}
      }
    </script>
  </head>
  <body>
    <ThemeScreens client:load />
  </body>
</html>
<style>
  html, body { margin: 0; background: var(--bg-2); }
  html { color-scheme: light; overflow: hidden; }
  html.dark { color-scheme: dark; }
</style>
<script>
  import '@antadesign/anta/elements'
</script>
