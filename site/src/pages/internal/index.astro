---
import antaStylesheet from '@antadesign/anta/bundle.css?url'

// Development tools for people working on Anta. They are not part of the
// documentation: no navigation entry, no search index, no sitemap entry.
const tools = [
  {
    href: '/internal/seed-lab/',
    title: 'Seed lab',
    summary: 'Compare the shipped tone derivation with a proposal that lets a seed’s lightness and chroma through within limits.',
  },
  {
    href: '/text-clipping/',
    title: 'Text clipping lab',
    summary: 'Inspect how each sized component clips accents and descenders.',
  },
  {
    href: '/test/',
    title: 'Component harness',
    summary: 'The page the property-based component tests drive.',
  },
]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Internal tools · Anta</title>
    <link rel="stylesheet" href={antaStylesheet} />
    <script is:inline>
      document.documentElement.classList.toggle('dark', matchMedia('(prefers-color-scheme: dark)').matches)
    </script>
  </head>
  <body>
    <main>
      <a-title level="1">Internal tools</a-title>
      <a-text priority="secondary">Development pages for people working on Anta. They are not linked from the documentation.</a-text>
      <ul>
        {tools.map(tool => (
          <li>
            <a href={tool.href}>{tool.title}</a>
            <a-text priority="tertiary" size="small">{tool.summary}</a-text>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
<style>
  html, body { margin: 0; background: var(--bg-2); color: var(--text-1); font-family: var(--sans-serif); }
  main { max-inline-size: 72ch; margin-inline: auto; padding: 32px 24px 64px; display: grid; gap: 12px; }
  ul { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 16px; }
  li { display: grid; gap: 2px; }
  a { color: var(--link-color); font-weight: 600; }
  a:hover { color: var(--link-color-hover); }
</style>
<script>
  import '@antadesign/anta/elements'
</script>
